{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nuxt-backend",
  "version": "0.1.0",
  "description": "All-in-one SaaS backend for Nuxt on Convex: passwordless auth with passkeys, workspaces and invitations, billing with credits and gifts, transactional email with delivery tracking, webhooks, metered AI and an MCP server — one Nuxt module and one Convex component, scaffolded into your app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qruto/nuxt-backend.git"
  },
  "license": "MIT",
  "author": "Slava Razum <razum@qruto.to>",
  "homepage": "https://nuxt-backend.dev",
  "bugs": {
    "url": "https://github.com/qruto/nuxt-backend/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/qruto"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "convex",
    "convex-component",
    "component",
    "backend",
    "saas",
    "fullstack",
    "authentication",
    "auth",
    "passkeys",
    "passwordless",
    "better-auth",
    "billing",
    "credits",
    "polar",
    "email",
    "resend",
    "webhooks",
    "mcp",
    "ai"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/module.js"
    },
    "./auth": {
      "types": "./dist/convex/client/index.d.ts",
      "default": "./dist/convex/client/index.js"
    },
    "./authorization": {
      "types": "./dist/convex/integrations/authorization.d.ts",
      "default": "./dist/convex/integrations/authorization.js"
    },
    "./http": {
      "types": "./dist/convex/integrations/http.d.ts",
      "default": "./dist/convex/integrations/http.js"
    },
    "./functions": {
      "types": "./dist/convex/integrations/functions.d.ts",
      "default": "./dist/convex/integrations/functions.js"
    },
    "./app": {
      "types": "./dist/convex/app.d.ts",
      "default": "./dist/convex/app.js"
    },
    "./billing": {
      "types": "./dist/convex/integrations/billing.d.ts",
      "default": "./dist/convex/integrations/billing.js"
    },
    "./email": {
      "types": "./dist/convex/integrations/email.d.ts",
      "default": "./dist/convex/integrations/email.js"
    },
    "./rate-limit": {
      "types": "./dist/convex/integrations/rate-limit.d.ts",
      "default": "./dist/convex/integrations/rate-limit.js"
    },
    "./migrations": {
      "types": "./dist/convex/integrations/migrations.d.ts",
      "default": "./dist/convex/integrations/migrations.js"
    },
    "./aggregate": {
      "types": "./dist/convex/integrations/aggregate.d.ts",
      "default": "./dist/convex/integrations/aggregate.js"
    },
    "./search": {
      "types": "./dist/convex/integrations/search.d.ts",
      "default": "./dist/convex/integrations/search.js"
    },
    "./workflows": {
      "types": "./dist/convex/integrations/workflows.d.ts",
      "default": "./dist/convex/integrations/workflows.js"
    },
    "./ai": {
      "types": "./dist/convex/integrations/ai.d.ts",
      "default": "./dist/convex/integrations/ai.js"
    },
    "./mcp": {
      "types": "./dist/runtime/server/mcp/index.d.ts",
      "default": "./dist/runtime/server/mcp/index.js"
    },
    "./convex.config": {
      "types": "./dist/convex/components/backend/convex.config.d.ts",
      "default": "./dist/convex/components/backend/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/convex/components/backend/convex.config.d.ts",
      "default": "./dist/convex/components/backend/convex.config.js"
    },
    "./_generated/component": {
      "types": "./dist/convex/components/backend/_generated/component.d.ts"
    },
    "./_generated/component.js": {
      "types": "./dist/convex/components/backend/_generated/component.d.ts"
    },
    "./auth.config": {
      "types": "./dist/convex/auth.config.d.ts",
      "default": "./dist/convex/auth.config.js"
    },
    "./test": "./src/convex/test.ts",
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "default": "./dist/eslint.mjs"
    }
  },
  "bin": {
    "nuxt-backend": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src/convex"
  ],
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "prepare": "test -d .githooks && git config core.hooksPath .githooks || true",
    "prepack": "pnpm run build",
    "build": "pnpm run build:nuxt-module && pnpm run build:convex-component && pnpm run build:devtools-client",
    "build:nuxt-module": "nuxt-module-build build && node scripts/normalize-module-ext.mjs",
    "build:devtools-client": "nuxt generate devtools-client-app",
    "build:convex-component": "node scripts/build-convex-component.mjs",
    "check:tarball": "node scripts/check-tarball.mjs",
    "budgets:update": "node scripts/budgets.mjs",
    "check:manifest": "installed-check -d --no-workspaces",
    "check:rulesets": "node scripts/check-rulesets.mjs",
    "check:consumer-types": "node scripts/check-consumer-types.mjs",
    "generate": "pnpm run pages:registry && pnpm run styles:imports && pnpm run design:gamut && pnpm run docs:reference && pnpm run docs:includes && pnpm run docs:style && pnpm run design:contrast && pnpm run playground:sync",
    "docs:includes": "node scripts/docs-includes.mjs",
    "playground:sync": "node scripts/sync-playground.mjs",
    "docs:reference": "typedoc && node scripts/typedoc-postprocess.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "docs:reference:check": "pnpm run docs:reference && git diff --exit-code -- website/content/docs/10.reference/10.api && git ls-files --others --exclude-standard -- website/content/docs/10.reference/10.api | (! grep .)",
    "analyze": "ANALYZE=true nuxt build --dotenv ../.env.local website",
    "dev": "pnpm run dev:prepare && run-p -r 'dev:convex-component' 'dev:website'",
    "dev:lan": "PORTLESS_LAN=1 pnpm run dev",
    "dev:convex-component": "convex dev --typecheck-components --start 'pnpm run dev:convex-component:watch'",
    "dev:convex-component:codegen": "convex codegen --component-dir ./src/convex/components/backend",
    "dev:convex-component:watch": "chokidar 'tsconfig*.json' 'src/convex/**/*.ts' -i '**/*.test.ts' -i 'src/convex/components/*/_generated/**' -c 'pnpm run dev:convex-component:codegen && pnpm run build:convex-component' --initial",
    "dev:devtools-client": "nuxt dev devtools-client-app",
    "dev:panel": "pnpm run dev:devtools-client",
    "dev:website": "portless nuxt-backend nuxt dev --dotenv ../.env.local website",
    "dev:website:share": "portless nuxt-backend --ngrok nuxt dev --dotenv ../.env.local website",
    "dev:prepare:lib": "nuxt-module-build build --stub && nuxt-module-build prepare && node scripts/normalize-module-ext.mjs && pnpm run build:convex-component && nuxt prepare devtools-client-app",
    "dev:prepare": "pnpm run dev:prepare:lib && nuxt prepare website",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:commits": "commitlint --verbose",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:convex": "tsc --noEmit -p tsconfig.convex.json",
    "typecheck:devtools-client": "nuxt typecheck devtools-client-app",
    "test": "vitest --run --project \"!e2e\"",
    "test:coverage": "vitest --run --coverage --project \"!e2e\" --project \"!docs\" --project \"!types\"",
    "test:watch": "vitest --watch --project \"!e2e\"",
    "test:types": "pnpm run test:types:lib && node scripts/typecheck-website.mjs && pnpm run typecheck:devtools-client",
    "test:types:lib": "pnpm run dev:prepare:lib && pnpm run typecheck && pnpm run typecheck:convex",
    "test:unit": "vitest --project unit --run",
    "test:nuxt": "vitest --project nuxt --run",
    "test:module": "vitest --project module --run",
    "test:e2e": "vitest --project e2e --run",
    "test:convex-component": "vitest --project convex-component --run",
    "test:quality": "fallow --fail-on-issues",
    "test:security": "fallow security --fail-on-issues",
    "skills": "npx -y skills@1.7.0",
    "skills:install": "npx -y skills@1.7.0 experimental_install",
    "skills:update": "npx -y skills@1.7.0 update -p -y",
    "bump": "pnpm exec taze major -w",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "test:docs": "vitest --project docs --run",
    "typecheck:subpaths": "vitest --project types --run",
    "upstream:check": "node scripts/check-upstream.mjs",
    "cli": "node dist/cli.mjs",
    "qa:screenshots": "vitest --project e2e --run test/e2e/screenshots.test.ts",
    "docs:style": "node scripts/docs-style.mjs",
    "design:contrast": "node scripts/design-contrast.mjs --write",
    "design:gamut": "node scripts/wide-gamut.mjs",
    "pages:registry": "node scripts/pages-registry.mjs",
    "styles:imports": "node scripts/stylesheet-imports.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": ">=1.6.25 <1.7.0",
    "@convex-dev/aggregate": "^0.3.3",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/migrations": "^0.3.7",
    "@convex-dev/persistent-text-streaming": "^0.3.4",
    "@convex-dev/polar": "^0.9.2",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@convex-dev/resend": "^0.2.9",
    "@convex-dev/workflow": "^0.4.10",
    "@nuxt/kit": "^4.6.2",
    "@nuxtjs/mcp-toolkit": "^0.24.2",
    "@polar-sh/checkout": "^0.4.3",
    "@polar-sh/sdk": "^0.49.0",
    "@vue/devtools-api": "^8.2.1",
    "better-auth": ">=1.6.25 <1.7.0",
    "buffer": "^6.0.3",
    "citty": "^0.2.2",
    "convex-helpers": "^0.1.128",
    "dedent": "^1.7.2",
    "defu": "^6.1.4",
    "h3": "^1.15.11",
    "magicast": "^0.5.4",
    "nuxt-convex-module": "~0.11.0",
    "nuxt-security": "^2.6.0",
    "resend": "^6.33.0",
    "standardwebhooks": "^1.0.0",
    "std-env": "^4.3.0",
    "svix": "^2.8.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "convex": ">=1.46.0 <2",
    "convex-test": ">=0.0.54",
    "eslint": "^9.0.0 || ^10.0.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/devtools-kit": "^3.4.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.0",
    "changelogen": "^0.6.2",
    "chokidar-cli": "^3.0.0",
    "convex": "^1.47.0",
    "convex-test": "^0.0.62",
    "eslint": "^10.13.0",
    "fallow": "3.33.1",
    "happy-dom": "^20.14.6",
    "installed-check": "^11.0.0",
    "lightningcss": "^1.33.0",
    "npm-run-all2": "^9.0.3",
    "nuxt": "catalog:",
    "oxc-parser": "^0.154.0",
    "pkg-pr-new": "^0.0.91",
    "playwright-core": "^1.64.1",
    "portless": "0.15.8",
    "publint": "^0.3.25",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "taze": "^21.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.3",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@convex-dev/eslint-plugin": {
      "optional": true
    },
    "convex-test": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
