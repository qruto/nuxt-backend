{
  "$schema": "https://typedoc.org/schema.json",
  // The third plugin resolves {@link} targets inside doc comments TypeDoc copies
  // from a dependency, through externalSymbolLinkMappings below.
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-frontmatter", "./scripts/typedoc-plugin-upstream-links.mjs"],
  "tsconfig": "tsconfig.typedoc.json",

  // One entry point per public module — the sources behind every runtime/convex
  // `exports` subpath, plus the auto-imported composables (which have no subpath
  // of their own). `test/nuxt/public-surface.test.ts` checks both directions.
  // The only subpath left out is `./component/_generated/component`: Convex
  // generates it, and it ships types only.
  "entryPoints": [
    "src/module.ts",
    "src/runtime/vue/composables/use-auth.ts",
    "src/runtime/vue/composables/use-billing.ts",
    "src/runtime/vue/composables/use-features.ts",
    "src/runtime/vue/composables/use-credits.ts",
    "src/runtime/vue/composables/use-gifts.ts",
    "src/runtime/vue/composables/use-organization.ts",
    "src/runtime/vue/composables/use-email-status.ts",
    "src/runtime/vue/composables/use-search.ts",
    "src/runtime/vue/composables/use-aggregate.ts",
    "src/runtime/vue/composables/use-workflow.ts",
    "src/runtime/vue/composables/use-ai-stream.ts",
    "src/runtime/vue/composables/use-login-flow.ts",
    "src/runtime/vue/composables/use-passkeys.ts",
    "src/runtime/vue/composables/use-sessions.ts",
    "src/runtime/vue/composables/use-orders.ts",
    "src/runtime/vue/composables/use-usage.ts",
    "src/runtime/vue/composables/use-backend-config.ts",
    "src/convex/client/index.ts",
    "src/convex/app.ts",
    "src/convex/integrations/http.ts",
    "src/convex/integrations/functions.ts",
    "src/convex/integrations/authorization.ts",
    "src/convex/integrations/billing.ts",
    "src/convex/integrations/email.ts",
    "src/convex/integrations/ai.ts",
    "src/convex/integrations/rate-limit.ts",
    "src/convex/integrations/migrations.ts",
    "src/convex/integrations/aggregate.ts",
    "src/convex/integrations/search.ts",
    "src/convex/integrations/workflows.ts",
    "src/runtime/server/mcp/index.ts",
    "src/convex/auth.config.ts",
    "src/convex/components/backend/convex.config.ts",
    "src/convex/components/backend/schema.ts",
    "src/convex/components/backend/email.ts",
    "src/convex/components/backend/billing.ts",
    "src/convex/components/backend/gifts.ts",
    "src/convex/components/backend/ai.ts",
    "src/convex/components/backend/webhooks.ts"
  ],
  "entryPointStrategy": "resolve",

  // Source links point at the branch, not the generating commit: the committed
  // reference (`pnpm docs:reference`) would otherwise churn on every commit and
  // the ci drift gate could never be green. The URL is spelled out rather than
  // derived from the git remote, so a fork or a clone with a different remote
  // name generates the same output. Git detection is off because TypeDoc only
  // recognises a `.git` *directory*: in a worktree, where `.git` is a file,
  // it finds no repository and drops every link, so the output would depend
  // on how the checkout was made. Without git, `{path}` is relative to the
  // entry points' common directory, `src/`, hence the prefix in the template.
  // (`basePath` / `displayBasePath` would move that root, but TypeDoc names
  // modules relative to them too, so every page would gain a `src/` prefix.)
  // A symbol that lives in a dependency gets a link that climbs out of `src/`
  // into `node_modules/`, which points at nothing on GitHub —
  // scripts/typedoc-postprocess.mjs keeps its path text and drops the link.
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/qruto/nuxt-backend/blob/main/src/{path}#L{line}",

  // The reference is a release gate: a JSDoc `{@link}` that does not resolve
  // renders as a bare word, and a public type that references an unexported one
  // documents a name nobody can import. Both fail the build.
  // `rewrittenLink` is off: it flags links that resolve to a reflection the
  // markdown router cannot anchor — members of inlined object types, which is
  // what a dependency's option bag becomes when a function returns it (better-
  // auth's `trustedOrigins` links to its sibling `baseURL`). Own links avoid
  // that shape by pointing at the enclosing type instead.
  "validation": {
    "invalidLink": true,
    "notExported": true,
    "rewrittenLink": false
  },
  "treatWarningsAsErrors": true,

  // Helper types a public signature mentions without exporting them: an inline
  // context shape, an internal validator input, a re-export's constraint. Each
  // is listed here rather than exported because an export is a public-surface
  // change (test/nuxt/public-surface.test.ts freezes that surface). TypeDoc
  // warns when an entry stops being referenced, so the list cannot go stale.
  "intentionallyNotExported": [
    "src/convex/catalog.ts:CatalogCustomField",
    "src/convex/catalog.ts:CatalogTaxBehavior",
    "src/convex/catalog.ts:CatalogTrial",
    "src/convex/catalog.ts:CatalogUsagePrice",
    "src/convex/client/index.ts:AuthRuntime",
    "src/convex/client/index.ts:DefaultAuthSchema",
    "src/convex/client/index.ts:OtpPurpose",
    "src/convex/client/index.ts:PublicAuthComponentRef",
    "src/convex/components/backend/billing.ts:SettleOutcome",
    "src/convex/integrations/billing.ts:AnyQueryCtx",
    "src/convex/integrations/billing.ts:CachedEntitlements",
    "src/convex/integrations/billing.ts:PolarConfig",
    "src/convex/integrations/billing.ts:RunQueryCtx",
    "src/convex/integrations/billing.ts:RunWriteCtx",
    "src/convex/integrations/email.ts:AnyActionCtx",
    "src/convex/integrations/email.ts:EventDataFor",
    "src/convex/integrations/functions.ts:Builders",
    "src/convex/integrations/mcp.ts:McpExchangeCtx",
    "src/convex/integrations/mcp.ts:McpRateLimiter",
    "src/convex/integrations/search.ts:Doc",
    "src/convex/integrations/search.ts:IndexName",
    "src/convex/integrations/search.ts:SearchIndexBound",
    "src/convex/integrations/search.ts:TableInfo",
    "src/convex/integrations/webhook-guard.ts:WebhookLogRefs",
    "src/convex/integrations/workflows.ts:SequenceEmailComponents",
    "src/pages.ts:ModulePagesOptions",
    "src/runtime/config.ts:BackendAppConfig",
    "src/runtime/vue/composables/use-billing.ts:EmptyArgs",
    "src/runtime/vue/composables/use-billing.ts:Query",
    "src/templates.ts:BackendInstallationMode"
  ],

  // Upstream symbols that doc comments link to — theirs, inherited through an
  // inlined type, or ours — resolved to the package's own documentation instead
  // of a bare name.
  "externalSymbolLinkMappings": {
    "convex": {
      "FunctionReference": "https://docs.convex.dev/api/modules/server#functionreference",
      "internalMutation": "https://docs.convex.dev/api/modules/server#internalmutation",
      "internalQuery": "https://docs.convex.dev/api/modules/server#internalquery"
    },
    "@convex-dev/better-auth": {
      "createClient": "https://labs.convex.dev/better-auth",
      "GetTokenOptions": "https://labs.convex.dev/better-auth"
    },
    "nuxt-convex-module": {
      "convexAuth": "https://nuxt-convex-module.dev/api-reference/reference/better-auth/server"
    },
    "@convex-dev/rate-limiter": {
      "tokenBucketValidator": "https://github.com/get-convex/rate-limiter#define-your-rate-limits",
      "fixedWindowValidator": "https://github.com/get-convex/rate-limiter#define-your-rate-limits"
    },
    "@convex-dev/aggregate": {
      "DirectAggregate": "https://github.com/get-convex/aggregate#readme"
    }
  },

  // Emit Markdown straight into the Docus content tree so it renders with the
  // site theme, sidebar, and search instead of TypeDoc's standalone HTML.
  "out": "website/content/7.api-reference/9.reference",
  "readme": "none",
  "githubPages": false,
  "hideGenerator": true,

  // The runtime + convex sources live in two TS configs; don't fail the build on
  // cross-world resolution noise — just document what resolves.
  "skipErrorChecking": true,

  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "sort": ["source-order"],

  // --- typedoc-plugin-markdown ----------------------------------------------
  // One Markdown file per module (members documented inline on their module
  // page), rather than one file per exported member. `router: "module"` is the
  // TypeDoc 0.28+ replacement for the now-deprecated `outputFileStrategy`.
  "router": "module",
  // Nuxt Content treats `index.md` (not README) as a folder's landing route.
  "entryFileName": "index",
  // Drop TypeDoc's breadcrumb/header block; the Docus sidebar handles navigation
  // and the `# <module>` H1 still gives Nuxt Content the page title.
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "propertiesFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",
  "indexFormat": "table",

  // --- typedoc-plugin-frontmatter -------------------------------------------
  // Give every generated page Nuxt Content frontmatter so Docus picks up titles
  // + includes them in navigation.
  "frontmatterGlobals": {
    "navigation": true
  }
}
