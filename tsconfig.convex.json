{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,

    "target": "ESNext",
    "lib": ["ES2023", "dom", "DOM.Iterable"],
    // Convex codegen emits `export const env = process.env` in _generated/server
    // when a component declares typed env vars — needs the Node `process` global.
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "noErrorTruncation": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "composite": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "verbatimModuleSyntax": true,
    // As in the root config: only syntax type stripping can erase.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  // The capabilities' registry too: the backend's health route detects its
  // capabilities with the registry's own detect (src/convex/integrations/health.ts),
  // so the build emits those runtime-neutral files beside dist/convex.
  "include": ["./src/convex/**/*", "./src/capabilities/**/*", "./src/env-registry.ts", "./src/devtools/rpc-types.ts", "./src/analyze/types.ts", "./src/findings/types.ts"]
}
