{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@1.9.0",
        "--autoConnect"
      ]
    },
    "convex": {
      "command": "npx",
      "args": [
        "-y",
        "convex@latest",
        "mcp",
        "start",
        "--project-dir",
        "."
      ]
    },
    "fallow": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "exec",
        "fallow-mcp"
      ]
    },
    "nuxt-docs": {
      "type": "http",
      "url": "https://nuxt.com/mcp"
    },
    "better-auth-docs": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "resend-docs": {
      "type": "http",
      "url": "https://resend.com/docs/mcp"
    },
    "resend": {
      "type": "http",
      "url": "https://mcp.resend.com/mcp"
    },
    "polar": {
      "command": "npx",
      "args": [
        "mcp-remote@0.14.3",
        "https://mcp.polar.sh/mcp/polar-sandbox"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    }
  }
}
