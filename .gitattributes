# Line endings are normalised to LF in the repository and on checkout. The test
# matrix has a windows-latest leg, so without this a contributor on Windows can
# commit CRLF and make a snapshot or a path assertion pass on one leg and fail on
# the other.
* text=auto eol=lf

# Executed as text on POSIX — a CRLF shebang line is a hard error, and these run
# as git hooks and CI scripts.
*.sh          text eol=lf
.githooks/*   text eol=lf

# Binary: never normalise, never diff.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.tgz    binary

# Text, despite looking like markup to some tools.
*.svg text

# Generated, so it stays out of the language statistics — but it is diffed.
# `-diff` would show every dependency change in a pull request as "binary files
# differ", and the lockfile is exactly where a supply-chain change is visible: a
# new transitive package, a resolved version, an integrity hash or a tarball URL
# that moved. `dependency-review` reads that delta; a reviewer has to be able to
# as well. GitHub still folds a `linguist-generated` file by default, so the
# diff is one click away rather than unreadable.
pnpm-lock.yaml linguist-generated
