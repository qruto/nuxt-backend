{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "build.config.ts",
    "nuxt.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "scripts/**/*.{ts,js}",
    "website/nuxt.config.ts",
    "website/app.config.ts",
    "website/app.css",
    "website/layouts/**/*.vue",
    "website/pages/**/*.vue",
    "website/components/**/*.vue",
    "website/server/**/*.ts",
    "website/backend/**/*.ts",
    "test/setup/**/*.ts",
    "test/helpers/**/*.ts",
    "test/fixtures/**/*.{ts,vue}",
    "test/fake-watch.ts"
  ],
  "ignorePatterns": [
    "dist/**",
    ".nuxt/**",
    "website/.nuxt/**",
    "website/backend/_generated/**",
    "src/convex/components/backend/_generated/**"
  ],
  "ignoreDependencies": [
    "@edge-runtime/vm",
    "@vue/test-utils",
    "oxc-parser"
  ],
  "ignoreExportsUsedInFile": true,
  "duplicates": {
    "ignore": [
      "**/_generated/**",
      "test/**",
      "src/runtime/vue/composables/**"
    ]
  },
  "health": {
    "ignore": [
      "test/**",
      "**/_generated/**",
      "src/runtime/vue/composables/**"
    ]
  }
}
