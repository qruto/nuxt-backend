#!/bin/sh
# Slow gate, runs once per push: the CI jobs that are too expensive to repeat on
# every commit. Together with pre-commit this mirrors every ci.yml job that can
# run on a laptop — see CONTRIBUTING.md § Git Hooks for the ones that cannot.
#
# TODO(fallow burndown): `pnpm exec fallow --fail-on-issues` and `pnpm exec
# fallow security --fail-on-issues` belong here (the whole-project run the
# scoped pre-commit audit cannot replace) once the ~58 pre-existing findings
# are burned down — see the note in pre-commit.
#
# Bypass once with: git push --no-verify
if [ -n "$CI" ]; then exit 0; fi

# git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line per ref
# being pushed, and an all-zero local sha means the ref is being deleted. A
# delete-only push carries no code, so there is nothing to check.
pushes_code=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) pushes_code=1 ;;
  esac
done
[ "$pushes_code" = 1 ] || exit 0

set -e

# `static` job's type check. vue-tsc reads `.nuxt/tsconfig.json` and resolves
# the package's own subpaths through `dist/`, both of which `dev:prepare:lib`
# produces — run it only when they are missing, so a prepared checkout (anyone
# who has run `pnpm dev`) pays nothing extra.
if [ ! -f .nuxt/tsconfig.json ] || [ ! -d dist/convex ]; then
  pnpm run dev:prepare:lib
fi
pnpm exec vue-tsc --noEmit

# `test` job, minus the Windows leg and the coverage thresholds, which need CI.
pnpm run test
