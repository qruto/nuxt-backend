#!/bin/sh
# Slow gate, runs once per push (~40s): the CI jobs that are too expensive to
# repeat on every commit. Together with pre-commit this mirrors every ci.yml
# job that can run on a laptop — see CONTRIBUTING.md § Git Hooks for the ones
# that cannot.
#
# Bypass once with: git push --no-verify
if [ -n "$CI" ]; then exit 0; fi

# git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line per ref
# being pushed, and an all-zero local sha means the ref is being deleted. A
# delete-only push carries no code, so there is nothing to check.
pushes_code=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) pushes_code=1 ;;
  esac
done
[ "$pushes_code" = 1 ] || exit 0

set -e

# `static` job's Quality step, whole-project — the same run pushes to main
# trigger. The pre-commit gate only sees the files a change touched, so it
# cannot notice a config edit that strands a file elsewhere in the repo; this
# can, in about half a second.
pnpm run test:quality

# `static` job's Security candidates step, for the same reason it is a
# separate command there: security candidates never surface under the run
# above.
pnpm run test:security

# `static` job's Manifest ranges step. Cheap, and the only check here that can
# fail without anyone changing anything — a dependency bump narrowing a peer
# range under us.
pnpm run check:manifest

# `static` job's two Type check steps. Runs dev:prepare:lib first, so it also
# proves the module still builds its stubs, its types and the Convex component.
pnpm run test:types:lib

# `test` job, minus the Windows leg and coverage thresholds, which need CI.
pnpm run test

# `static` job's API reference drift step. Regenerating must produce no diff,
# or the committed reference and the source doc-comments have diverged. This
# one rewrites files: if it fails, the regenerated reference is already in your
# working tree, ready to commit.
pnpm run docs:reference
if ! git diff --quiet -- website/content/7.api-reference/9.reference; then
  echo >&2
  echo "pre-push: the API reference drifted — commit the regenerated files below." >&2
  git --no-pager diff --stat -- website/content/7.api-reference/9.reference >&2
  exit 1
fi
